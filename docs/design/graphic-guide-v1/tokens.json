{
  "version": "1.0",
  "scope": "guided-lessons-design",
  "status": "normative-design-reference-not-runtime-configuration",
  "colors": {
    "ivory": "#FAF8F4",
    "navy": "#10245C",
    "cobalt": "#245CFF",
    "lilac": "#EEE8FA",
    "slate": "#506187",
    "green": "#08775E",
    "coralDecorationOnly": "#DC5968",
    "sageIllustrationOnly": "#71856B",
    "errorText": "#C13E50",
    "negationText": "#C13E50",
    "primaryLabel": "#FFFFFF",
    "controlStroke": "#506187"
  },
  "typography": {
    "body": { "family": "Nunito, system-ui, sans-serif", "minimumPx": 16, "lineHeight": 1.5 },
    "taskHeading": { "family": "Georgia, serif", "desktopPx": 32, "mobilePx": 26, "weight": 700 },
    "unitBreadcrumb": { "sizePx": 14, "role": "secondary" },
    "technicalOnly": { "family": "Geist Mono, monospace" }
  },
  "spacingPx": [8, 16, 24, 32, 48],
  "radiiPx": { "small": 8, "field": 16, "media": 24, "footerButton": 999 },
  "focus": { "color": "#10245C", "widthPx": 2, "clearSurfaceOffsetPx": 2 },
  "motion": { "stateMs": 160, "instructionalTransformMaximumMs": 240, "reducedMotionMs": 0, "blocksInteraction": false },
  "controls": {
    "minimumTargetPx": 44,
    "primaryHeightPx": 48,
    "primaryActionsPerFooter": 1,
    "primaryPosition": "footer-end",
    "exerciseActionSequence": ["Comprobar", "Siguiente"],
    "sequenceDependsOnExistingExerciseRules": true,
    "moveActions": "outlined",
    "horizontalOrderingArrows": ["left", "right"],
    "classification": "any-configured-category-by-click-or-keyboard"
  },
  "illustration": {
    "style": "adult semi-realistic painterly editorial, subtle brush texture, natural proportions, matte light",
    "charactersReference": "characters.webp",
    "scenesReference": "scenes-ui.webp",
    "identities": {
      "lucas": "warm tan skin, tousled dark-brown curly hair, short beard, cobalt overshirt, white tee",
      "carl": "dark brown skin, cropped black hair, clean-shaven face, round glasses, sage shirt",
      "interlocutora": "warm medium skin, loose dark-brown bun, cream and navy striped top"
    },
    "excludedStyles": ["photorealistic decoration", "3D", "anime", "childish flat cartoon", "plastic gloss"]
  },
  "assets": {
    "format": "webp",
    "runtimeMaximumLongEdgePx": 1200,
    "runtimeQualityReference": 82,
    "mockupBoardWidthPx": 1536,
    "mockupBoardQuality": 92,
    "canonicalPlateQuality": 94,
    "preserveGeneratedOriginals": true
  },
  "accessibility": {
    "normalTextMinimumContrast": 4.5,
    "largeTextMinimumContrast": 3,
    "decorativeImageAlt": "",
    "requiredControlsHaveVisibleOrAccessibleNames": true,
    "dragHasClickAndKeyboardAlternative": true,
    "reducedMotion": "remove-nonessential-motion-preserve-state-and-feedback",
    "staticMockupsAreNotAccessibilityCertification": true
  }
}

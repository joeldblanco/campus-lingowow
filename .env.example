# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lingowow

# Authentication
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_SECRET=your_auth_secret_min_32_chars
JWT_SECRET=your_jwt_secret

# Email
RESEND_API_KEY=your_resend_api_key

# Application
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# LiveKit (LEGACY - only needed if CLASSROOM_PROVIDER=LIVEKIT)
# The self-hosted server that served meet.lingowow.com was decommissioned.
# Point these at a LiveKit Cloud project or your own deployment before use.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Classroom provider
# GOOGLE_MEET is the active low-cost provider. LIVEKIT remains as legacy fallback.
CLASSROOM_PROVIDER=GOOGLE_MEET

# Google Meet API - Service Account with domain-wide delegation
GOOGLE_MEET_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_MEET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
GOOGLE_MEET_IMPERSONATED_USER=admin@your-domain.com
GOOGLE_MEET_ACCESS_TYPE=OPEN

# Jitsi JaaS (DEPRECATED - Replaced by LiveKit)
# NEXT_PUBLIC_JAAS_APP_ID=your_jaas_app_id
# JAAS_APP_ID=your_jaas_app_id
# JAAS_KID=your_jaas_key_id
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# PayPal Configuration
# Get your credentials from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
# Change to 'live' for production
# Webhook ID from the PayPal app's "Webhooks" section. REQUIRED: the PayPal
# webhook handler rejects every delivery whose signature cannot be verified
# against this ID (without it, all webhooks are rejected — and forged ones
# could otherwise trigger free enrollments).
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# Cron Jobs (Vercel)
# Generate a random secret for cron job authentication
CRON_SECRET=your_cron_secret_min_32_chars

# Google reCAPTCHA v3
# Get your keys from https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Socket.io (realtime messaging)
# Relay server lives outside this repo (see server/socketio).
# Browser-facing URL; falls back to https://ws.lingowow.com when unset.
NEXT_PUBLIC_SOCKETIO_URL=https://ws.lingowow.com
# Server-side emit endpoint. Goes through the relay's TLS reverse proxy —
# the raw 3001 port is not exposed to the internet.
SOCKETIO_INTERNAL_URL=https://ws.lingowow.com
SOCKETIO_INTERNAL_SECRET=your_socketio_internal_secret

# AI Assistant (Gemini)
GEMINI_API_KEY=your_gemini_api_key

# LingoFlow (obligatoria): credencial dedicada con permisos SELECT-only.
# No uses DATABASE_URL ni una credencial de la base de datos primaria como fallback.
LINGOFLOW_DATABASE_URL=postgresql://lingoflow_readonly:password@localhost:5432/lingowow
LINGOFLOW_AI_ENABLED=false

# Telegram Bot (Admin notifications from AI Assistant)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# The chat ID of your admin group (use @userinfobot to find it)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id
